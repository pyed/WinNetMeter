#include <windows.h>

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "mcagriaksoy"
            VALUE "FileDescription", "Lightweight network speed monitor with tray icon and taskbar widget."
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "NetworkMonitorLite"
            VALUE "LegalCopyright", "Copyright (c) 2025-2026 mcagriaksoy"
            VALUE "OriginalFilename", "NetworkMonitorLite.exe"
            VALUE "ProductName", "NetworkMonitorLite"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
